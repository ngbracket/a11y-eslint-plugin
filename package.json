{
  "name": "@ngbracket/a11y-eslint-plugin",
  "version": "0.1.1",
  "description": "ESLint rules that check Angular templates for missing accessible names, including on custom components you map to native elements.",
  "license": "MIT",
  "author": "Duncan Faulkner",
  "contributors": [
    "Lara Sanz"
  ],
  "homepage": "https://ngbracket.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngbracket/a11y-eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/ngbracket/a11y-eslint-plugin/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "angular",
    "angular-eslint",
    "accessibility",
    "a11y",
    "ngbracket"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@angular-eslint/template-parser": ">=18.0.0",
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^22.5.0",
    "@typescript-eslint/utils": "^8.70.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
